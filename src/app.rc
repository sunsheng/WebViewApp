#include "resource.h"
#include <windows.h>

101 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MyCompany"
            VALUE "FileDescription",  "WebViewApp"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "WebViewApp"
            VALUE "LegalCopyright",   "Copyright 2025 MyCompany"
            VALUE "OriginalFilename", "WebViewApp.exe"
            VALUE "ProductName",      "WebViewApp"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
