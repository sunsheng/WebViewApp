<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product Id="*"
           Name="xstack"
           Language="1033"
           Version="!(bind.FileVersion.xstackEXE)"
           Manufacturer="MyCompany"
           UpgradeCode="B2C3D4E5-F6A7-8901-BCDE-F12345678901">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="xstack Installer"
             Manufacturer="MyCompany" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Binary Id="WebView2Bootstrapper"
            SourceFile="..\redist\MicrosoftEdgeWebview2Setup.exe" />

    <CustomAction Id="InstallWebView2"
                  BinaryKey="WebView2Bootstrapper"
                  ExeCommand="/silent /install"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <Property Id="WEBVIEW2_INSTALLED">
      <RegistrySearch Id="WebView2RegSearch"
                      Root="HKLM"
                      Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv"
                      Type="raw"
                      Win64="no" />
    </Property>
    <Property Id="WEBVIEW2_INSTALLED_64">
      <RegistrySearch Id="WebView2RegSearch64"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv"
                      Type="raw"
                      Win64="yes" />
    </Property>

    <Condition Message="Windows 10 version 1803 or later is required.">
      <![CDATA[VersionNT >= 603]]>
    </Condition>

    <InstallExecuteSequence>
      <Custom Action="InstallWebView2" Before="InstallFinalize">
        <![CDATA[NOT WEBVIEW2_INSTALLED AND NOT WEBVIEW2_INSTALLED_64]]>
      </Custom>
    </InstallExecuteSequence>

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="xstack" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="xstack" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="xstackEXEComponent"
                 Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012">
        <File Id="xstackEXE"
              Source="..\bin\x64\Release\xstack.exe"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut"
                 Guid="D4E5F6A7-B8C9-0123-DEF0-234567890123">
        <Shortcut Id="StartMenuShortcutEntry"
                  Name="xstack"
                  Description="xstack"
                  Target="[INSTALLFOLDER]xstack.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\MyCompany\xstack"
                       Name="StartMenuInstalled"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut"
                 Guid="E5F6A7B8-C9D0-1234-EF01-345678901234">
        <Shortcut Id="DesktopShortcutEntry"
                  Name="xstack"
                  Description="xstack"
                  Target="[INSTALLFOLDER]xstack.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\MyCompany\xstack"
                       Name="DesktopInstalled"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="xstack" Level="1">
      <ComponentRef Id="xstackEXEComponent" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

  </Product>
</Wix>
